                                <rect key="frame" x="118" y="363" width="157" height="157"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="6Tk-OE-BBY"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="Grd-Lc-001" firstAttribute="top" secondItem="Ze5-6b-2t3" secondAttribute="top" id="Grd-Cn-top"/>
                            <constraint firstItem="Grd-Lc-001" firstAttribute="bottom" secondItem="Ze5-6b-2t3" secondAttribute="bottom" id="Grd-Cn-bot"/>
