                            <constraint firstItem="Bdg-Lc-002" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="Bdg-Cn-cx0"/>
                            <constraint firstItem="Bdg-Lc-002" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" multiplier="1.09" id="Bdg-Cn-cy0"/>
                            <constraint firstItem="Bdg-Lc-002" firstAttribute="width" secondItem="Ze5-6b-2t3" secondAttribute="width" multiplier="0.394737" priority="750" id="Bdg-Cn-wid"/>
