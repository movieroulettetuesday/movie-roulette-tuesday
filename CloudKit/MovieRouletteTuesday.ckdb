// CloudKit schema for Movie Roulette Tuesday
// Container: iCloud.com.movieroulettetuesday.app
// Database: PUBLIC
//
// Import in CloudKit Console (Development → Schema), then Promote to Production
// before App Store release. See SCHEMA.md.
//
// Privacy: fields never hold a user id, name, email, or device id. One vote /
// rating per user is enforced by a deterministic recordName that hashes the
// iCloud user record name (never stored in a field).

DEFINE SCHEMA

RECORD TYPE PollVote (
    "___createTime" TIMESTAMP,
    "___createdBy"  REFERENCE,
    "___etag"       STRING,
    "___modTime"    TIMESTAMP,
    "___modifiedBy" REFERENCE,
    "___recordID"   REFERENCE QUERYABLE,
    option          STRING,
    pollId          STRING QUERYABLE,
    GRANT WRITE TO "_creator",
    GRANT CREATE TO "_icloud",
    GRANT READ TO "_world"
);

RECORD TYPE ListenerRating (
    "___createTime" TIMESTAMP,
    "___createdBy"  REFERENCE,
    "___etag"       STRING,
    "___modTime"    TIMESTAMP,
    "___modifiedBy" REFERENCE,
    "___recordID"   REFERENCE QUERYABLE,
    halfStars       INT64,
    movieId         STRING QUERYABLE,
    stars           INT64,
    GRANT WRITE TO "_creator",
    GRANT CREATE TO "_icloud",
    GRANT READ TO "_world"
);

// In-app movie suggestions (backup to email). Listeners can only CREATE:
// no READ for "_world" or "_icloud", so nobody can see others' submissions.
// The hosts read them in CloudKit Console (Production → Records → Suggestion,
// sorted by created date).
RECORD TYPE Suggestion (
    "___createTime" TIMESTAMP SORTABLE QUERYABLE,
    "___createdBy"  REFERENCE,
    "___etag"       STRING,
    "___modTime"    TIMESTAMP,
    "___modifiedBy" REFERENCE,
    "___recordID"   REFERENCE QUERYABLE,
    appVersion      STRING,
    category        STRING,
    creditName      STRING,
    note            STRING,
    title           STRING,
    GRANT CREATE TO "_icloud"
);
